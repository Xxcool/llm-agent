# 前端由 scripts/prepare_deploy.py 在本地构建后打包，降低免费云构建的负担。
FROM python:3.12-slim
WORKDIR /app/backend
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
COPY backend/app ./app
COPY backend/knowledge ./knowledge
COPY frontend/dist /app/frontend/dist
ENV PORT=7860 \
    DATA_DIR=/tmp/llm-agent-data \
    SNAPSHOT_DIR=/mnt/workspace/llm-agent-snapshots \
    EMBED_BACKEND=hash \
    MULTI_TENANT=1 \
    REQUIRE_USER_API_KEY=1 \
    CLIENT_COOKIE_SECURE=true
EXPOSE 7860
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7860", "--workers", "1"]
